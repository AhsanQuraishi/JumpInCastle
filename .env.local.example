# Copy this file to .env.local and fill in your Supabase project values.
# Project Settings > API in your Supabase dashboard.

SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Admin dashboard (/admin) login. Pick your own password; generate the
# secret with: node -e "console.log(require('crypto').randomBytes(24).toString('hex'))"
ADMIN_PASSWORD=change-me
ADMIN_SESSION_SECRET=change-me-too
